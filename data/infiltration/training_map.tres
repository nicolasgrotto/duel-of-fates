rows = PackedStringArray("##############################", "#................#...........#", "#................#...........#", "#......CCC.......#...........#", "#................#...........#", "#..============..#...........#", "#............................#", "#............................#", "#.........CC.................#", "#................#...........#", "#................#...........#", "#######..#########...........#", "#...CC...........#...........#", "#................#...........#", "#......................CCC...#", "#................#...........#", "#................#...........#", "#............................#", "#............................#", "##############################")
