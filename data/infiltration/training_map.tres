[gd_resource type="Resource" script_class="InfiltrationMapData" format=3]

[ext_resource type="Script" path="res://data/infiltration/infiltration_map_data.gd" id="map"]
[ext_resource type="Script" path="res://data/infiltration/infiltration_target_data.gd" id="target"]
[ext_resource type="Resource" path="res://data/bolts/standard_bolt.tres" id="bolt"]
