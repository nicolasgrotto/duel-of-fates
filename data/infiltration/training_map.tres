[ext_resource type="Texture2D" path="res://assets/infiltration/training_sprites.png" id="sprites"]

[sub_resource type="Resource" id="dummy"]
script = ExtResource("target")
id = &"training_dummy"
position = Vector2(480, 480)
health = 30.0

[sub_resource type="Resource" id="emitter"]
script = ExtResource("target")
