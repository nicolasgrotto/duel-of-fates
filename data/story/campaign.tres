[ext_resource type="Resource" path="res://data/story/encounters/sanctuary_wall.tres" id="e_sanctuary_wall"]
[ext_resource type="Resource" path="res://data/story/encounters/shadow.tres" id="e_shadow"]
[ext_resource type="Resource" path="res://data/story/encounters/shadow_awakens.tres" id="e_shadow_awakens"]
[ext_resource type="Resource" path="res://data/story/encounters/sovereign.tres" id="e_sovereign"]
[ext_resource type="Resource" path="res://data/story/encounters/eclipse_foretold.tres" id="e_eclipse_foretold"]
