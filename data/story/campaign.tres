[ext_resource type="Resource" path="res://data/story/endings/ring_silent.tres" id="n_ring_silent"]
[ext_resource type="Resource" path="res://data/story/endings/heir_returns.tres" id="n_heir_returns"]
[ext_resource type="Resource" path="res://data/story/endings/forest_yields.tres" id="n_forest_yields"]
[ext_resource type="Resource" path="res://data/story/endings/balance.tres" id="n_balance"]

[resource]
script = ExtResource("1_campaign")
common = Array[ExtResource("2_encounter")]([ExtResource("e_trial"), ExtResource("e_echoes"), ExtResource("e_rooftop_wasp"), ExtResource("e_ember_mine")])
aurora = Array[ExtResource("2_encounter")]([ExtResource("e_sanctuary_wall"), ExtResource("e_shadow"), ExtResource("e_shadow_awakens"), ExtResource("e_sovereign")])
eclipse = Array[ExtResource("2_encounter")]([ExtResource("e_reaper_test"), ExtResource("e_mirror_temple"), ExtResource("e_rooftop_heron"), ExtResource("e_elder")])
aurora_secret = ExtResource("e_eclipse_foretold")
eclipse_secret = ExtResource("e_aurora_foretold")
aurora_normal_ending = ExtResource("n_ring_silent")
aurora_secret_ending = ExtResource("n_heir_returns")
eclipse_normal_ending = ExtResource("n_forest_yields")
eclipse_secret_ending = ExtResource("n_balance")
