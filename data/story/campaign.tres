[gd_resource type="Resource" script_class="CampaignData" format=3]

[ext_resource type="Script" path="res://data/story/campaign_data.gd" id="1_campaign"]
[ext_resource type="Script" path="res://data/story/encounter_data.gd" id="2_encounter"]
[ext_resource type="Resource" path="res://data/story/encounters/trial.tres" id="e_trial"]
[ext_resource type="Resource" path="res://data/story/encounters/echoes.tres" id="e_echoes"]
[ext_resource type="Resource" path="res://data/story/encounters/rooftop_wasp.tres" id="e_rooftop_wasp"]
