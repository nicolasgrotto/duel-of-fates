[resource]
script = ExtResource("1_campaign")
common = Array[ExtResource("2_encounter")]([ExtResource("e_trial"), ExtResource("e_echoes"), ExtResource("e_rooftop_wasp"), ExtResource("e_ember_mine")])
aurora = Array[ExtResource("2_encounter")]([ExtResource("e_sanctuary_wall"), ExtResource("e_shadow"), ExtResource("e_shadow_awakens"), ExtResource("e_sovereign")])
eclipse = Array[ExtResource("2_encounter")]([ExtResource("e_reaper_test"), ExtResource("e_mirror_temple"), ExtResource("e_rooftop_heron"), ExtResource("e_elder")])
aurora_secret = ExtResource("e_eclipse_foretold")
eclipse_secret = ExtResource("e_aurora_foretold")
aurora_normal_ending = ExtResource("n_ring_silent")
aurora_secret_ending = ExtResource("n_heir_returns")
eclipse_normal_ending = ExtResource("n_forest_yields")
eclipse_secret_ending = ExtResource("n_balance")
aurora_tree = Array[ExtResource("tree_node")]([SubResource("aurora_0"), SubResource("aurora_1"), SubResource("aurora_2"), SubResource("aurora_3"), SubResource("aurora_4"), SubResource("aurora_5"), SubResource("aurora_6"), SubResource("aurora_7"), SubResource("aurora_8"), SubResource("aurora_9"), SubResource("aurora_10"), SubResource("aurora_11")])
eclipse_tree = Array[ExtResource("tree_node")]([SubResource("eclipse_0"), SubResource("eclipse_1"), SubResource("eclipse_2"), SubResource("eclipse_3"), SubResource("eclipse_4"), SubResource("eclipse_5"), SubResource("eclipse_6"), SubResource("eclipse_7"), SubResource("eclipse_8"), SubResource("eclipse_9"), SubResource("eclipse_10"), SubResource("eclipse_11")])
skill_points_win = 3
skill_points_loss = 1
skill_points_milestone = 1
skill_points_secret = 3
blaster_tree = Array[ExtResource("tree_node")]([SubResource("blaster_0"), SubResource("blaster_1"), SubResource("blaster_2")])
blade_tree = Array[ExtResource("tree_node")]([SubResource("blade_0"), SubResource("blade_1"), SubResource("blade_2"), SubResource("blade_3"), SubResource("blade_4")])

milestone_points = Array[PackedInt32Array]([PackedInt32Array(3, 3), PackedInt32Array(3, 2), PackedInt32Array(2, 2)])
