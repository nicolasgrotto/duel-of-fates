[resource]
script = ExtResource("1_script")
powers = Array[ExtResource("2_power")]([ExtResource("p_repulse"), ExtResource("p_pull"), ExtResource("p_throw"), ExtResource("p_mind_twist"), ExtResource("p_supreme_push"), ExtResource("p_fracture"), ExtResource("p_barrier"), ExtResource("p_heal"), ExtResource("p_focus"), ExtResource("p_absorption"), ExtResource("p_sanctuary"), ExtResource("p_mass_telekinesis"), ExtResource("p_flow_cleave"), ExtResource("p_lightning"), ExtResource("p_choke"), ExtResource("p_freeze"), ExtResource("p_storm"), ExtResource("p_wrath"), ExtResource("p_drain"), ExtResource("p_arsenal")])
