[gd_resource type="Resource" script_class="LessonData" format=3]

[ext_resource type="Script" path="res://data/lessons/lesson_data.gd" id="1_lesson"]
[ext_resource type="Script" path="res://data/lessons/lesson_step.gd" id="2_step"]

[sub_resource type="Resource" id="step_0"]
script = ExtResource("2_step")
