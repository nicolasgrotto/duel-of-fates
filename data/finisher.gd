class_name Finisher

enum Kind { NONE, DASH_THROUGH, WAIST, VERTICAL, DIAGONAL, PULL_CUT, CHARRED, BLAST, CHOKED, EXECUTION, SCISSORS, STAB, TWIN_BLADES, OVERHEAD, DOUBLE_ROTATION, WHIRL, CROSSED_EXECUTION, PRECISE_SENTENCE, GUARDIAN_DISARM, GUARDIAN_RETURN, GUARDIAN_COUNTER, GUARDIAN_BOW, AGGRESSOR_RISING, AGGRESSOR_THREE, AGGRESSOR_THROAT, COLOSSUS_CRUSH, COLOSSUS_CLEAVE, COLOSSUS_LEG, WASP_REVERSE, WASP_SWARM, WASP_CROSS, WASP_SPIRAL, FENCER_SALUTE, FENCER_TRIPLE, FENCER_LINE, FENCER_HEART, STRIKER_FEINT, STRIKER_ANSWER, STRIKER_BEHIND, STRIKER_DOUBLE, DANCER_LEAP, DANCER_LOW, DANCER_DESCENT, REAPER_WHEEL, REAPER_HOOK, REAPER_X, REAPER_CHEST, VERSATILE_SHOT_CUT, VERSATILE_TWO_SHOTS, VERSATILE_POINT_BLANK, X_CUT }

const STAGED: Array[Kind] = [Kind.EXECUTION, Kind.SCISSORS, Kind.STAB, Kind.TWIN_BLADES, Kind.OVERHEAD, Kind.DOUBLE_ROTATION, Kind.WHIRL, Kind.CROSSED_EXECUTION, Kind.PRECISE_SENTENCE, Kind.GUARDIAN_DISARM, Kind.GUARDIAN_RETURN, Kind.GUARDIAN_COUNTER, Kind.GUARDIAN_BOW, Kind.AGGRESSOR_RISING, Kind.AGGRESSOR_THREE, Kind.AGGRESSOR_THROAT, Kind.COLOSSUS_CRUSH, Kind.COLOSSUS_CLEAVE, Kind.COLOSSUS_LEG, Kind.WASP_REVERSE, Kind.WASP_SWARM, Kind.WASP_CROSS, Kind.WASP_SPIRAL, Kind.FENCER_SALUTE, Kind.FENCER_TRIPLE, Kind.FENCER_LINE, Kind.FENCER_HEART, Kind.STRIKER_FEINT, Kind.STRIKER_ANSWER, Kind.STRIKER_BEHIND, Kind.STRIKER_DOUBLE, Kind.DANCER_LEAP, Kind.DANCER_LOW, Kind.DANCER_DESCENT, Kind.REAPER_WHEEL, Kind.REAPER_HOOK, Kind.REAPER_X, Kind.REAPER_CHEST, Kind.VERSATILE_SHOT_CUT, Kind.VERSATILE_TWO_SHOTS, Kind.VERSATILE_POINT_BLANK]

const BEHIND: Array[Kind] = [Kind.GUARDIAN_RETURN, Kind.FENCER_LINE, Kind.STRIKER_BEHIND, Kind.DANCER_LEAP]


static func is_staged(kind: Kind) -> bool:
	return STAGED.has(kind)


static func steps_back(kind: Kind) -> bool:
	return kind == Kind.CROSSED_EXECUTION


static func passes_behind(kind: Kind) -> bool:
	return kind == Kind.WHIRL or kind == Kind.PRECISE_SENTENCE or BEHIND.has(kind)


static func is_long(kind: Kind) -> bool:
	return kind == Kind.TWIN_BLADES or kind == Kind.CROSSED_EXECUTION or kind == Kind.PRECISE_SENTENCE


static func fits(kind: Kind, victim_weapon: WeaponData.Kind) -> bool:
	return kind != Kind.TWIN_BLADES or victim_weapon == WeaponData.Kind.SINGLE
